<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Il2CppInspector.Common/Il2CppInspector.Common.csproj" />
    <Compile Include="../TOT_CN_Android_6.1.0/IL2CPP/*.cs" Link="IL2CPP/%(Filename)%(Extension)" />
    <Compile Include="../TOT_CN_Android_6.1.0/Next/Metadata/*.cs" Link="Next/Metadata/%(Filename)%(Extension)" />
    <Compile Include="../TOT_CN_Android_6.1.0/Model/*.cs" Link="Model/%(Filename)%(Extension)" />
    <Compile Include="../TOT_CN_Android_6.1.0/Reflection/*.cs" Link="Reflection/%(Filename)%(Extension)" />
    <EmbeddedResource
      Include="../TOT_CN_Android_6.1.0/Resources/TotWhiteboxTables.bin"
      LogicalName="Il2CppInspector.Plugin.TOT.TotWhiteboxTables.bin"
    />
    <InternalsVisibleTo Include="Il2CppInspector.Tests" />
  </ItemGroup>
</Project>
