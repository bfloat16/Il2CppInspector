<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Il2CppInspector.Plugin.HSR</RootNamespace>
  </PropertyGroup>
  <Import Project="../Shared/Morax/Morax.props" />
  <ItemGroup>
    <ProjectReference Include="../../Il2CppInspector.Common/Il2CppInspector.Common.csproj" />
    <!-- Sources identical to OS 4.6.0. Copy a file here before giving it 4.6.51-specific changes. -->
    <Compile Include="../HSR_OS_Windows_4.6.0/HsrPlugin.cs" Link="HsrPlugin.cs" />
    <Compile Include="../HSR_OS_Windows_4.6.0/IL2CPP/*.cs" Link="IL2CPP/%(Filename)%(Extension)" />
    <Compile Include="../HSR_OS_Windows_4.6.0/Model/*.cs" Link="Model/%(Filename)%(Extension)" />
    <Compile Include="../HSR_OS_Windows_4.6.0/Next/Metadata/*.cs" Link="Next/Metadata/%(Filename)%(Extension)" />
    <Compile Include="../HSR_OS_Windows_4.6.0/Reflection/*.cs" Link="Reflection/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
